# eSKala Backend Environment Configuration
APP_NAME="eSKala API"
APP_VERSION="1.0.0"
DEBUG=True

SECRET_KEY=eskala-dev-secret-key-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite for local development — swap to Supabase PostgreSQL URL when ready
